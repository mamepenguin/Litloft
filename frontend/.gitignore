# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated: merged translation files (built by scripts/merge-addon-messages.mjs)
/src/messages/

# generated: the compiled stylesheet the layout fixture links
# (built by e2e-layout/build-fixture-css.ts)
/e2e-layout/fixtures/globals.built.css

# The component fixture's bundle (built by e2e-components/build-bundle.ts)
/e2e-components/.build/
