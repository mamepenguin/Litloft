# Copy to .env and fill in real values. .env is gitignored.
#
# LLM API key for the intelligence addon.
# Used by: auto-tags / summaries / Ask (RAG) / transcript-refine.
# Provider (OpenAI / DeepSeek / ollama / vLLM / LM Studio etc.) is selected
# in addons/intelligence/search-config.yml -> llm.provider + llm.base_url.
# For local providers like ollama, any non-empty string works.
LLM_API_KEY=sk-your-api-key-here

# Shared secret for knowledge addon lifecycle webhooks.
# The core process signs files.missing/recovered/purged callbacks with
# this secret (via event-hooks.json "secret_env"), and the knowledge
# addon verifies the X-Webhook-Secret header against it. Without this
# any Docker-internal process could forge lifecycle events and delete
# note_origin_sources rows. Generate with `openssl rand -hex 32`.
KNOWLEDGE_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Shared secret for intelligence addon lifecycle webhooks.
# Same mechanism as the knowledge one above: the core signs the
# scan.complete / files.* callbacks it POSTs to the intelligence addon
# (via event-hooks.json "secret_env"), and the addon verifies the
# X-Webhook-Secret header against it.
#
# It has to reach BOTH containers. The backend builds the header from its
# own environment and the intelligence container checks it, so a value
# passed to only one side is worse than none: with the addon armed and
# core sending nothing, all seven webhooks 403 and indexing stops with no
# other symptom.
#
# It also only takes effect when addons/intelligence/manifest.json
# declares "secret_env": "SEARCH_WEBHOOK_SECRET" on every listener — that
# declaration is what makes core attach the header at all, and it is what
# configure.py checks before wiring either container.
# Generate with `openssl rand -hex 32`.
SEARCH_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Shared secret for addon → core internal content reads. Gates the
# GET /api/internal/files/{id}/content endpoint, which the knowledge
# note scanner uses to reconcile Vault .md frontmatter on
# password-protected drives (the scanner has no user cookie and cannot
# go through the cookie-gated /api/files/{id}/stream path). Without
# this the Docker network boundary is the only layer of defence on
# content reads. Generate with `openssl rand -hex 32`.
CORE_INTERNAL_SECRET=generate-with-openssl-rand-hex-32
