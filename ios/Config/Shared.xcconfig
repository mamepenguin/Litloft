// Identity that differs per developer. Defaults here keep a fresh clone
// building for the simulator; Local.xcconfig overrides them for a device.
LITLOFT_BUNDLE_ID = com.mamepenguin.Litloft
LITLOFT_DEVELOPMENT_TEAM =

// Debug builds install beside Release as a separate app: its own bundle id
// means its own server address, session and data.
LITLOFT_BUNDLE_ID_SUFFIX =
LITLOFT_BUNDLE_ID_SUFFIX[config=Debug] = .dev
LITLOFT_DISPLAY_NAME = Litloft
LITLOFT_DISPLAY_NAME[config=Debug] = Litloft Dev

// The App Group is the app's bundle id, never the extension's. The keychain
// access group needs the provisioning prefix; a build without a team leaves
// it empty and falls back to the bare group.
LITLOFT_APP_GROUP = group.$(LITLOFT_BUNDLE_ID)$(LITLOFT_BUNDLE_ID_SUFFIX)
LITLOFT_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(LITLOFT_APP_GROUP)

// Optional, and not tracked. Copy Local.xcconfig.example to create it.
#include? "Local.xcconfig"
