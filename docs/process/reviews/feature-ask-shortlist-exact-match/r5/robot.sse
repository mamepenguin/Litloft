data: {"citation": {"file_id": "DuRk8Z-B68TR", "drive": "動画", "filename": "【買うなら今！】Amazonプライムデーで今買うべきおすすめアイテム『14選』.loft", "file_type": "video", "quote": "買うと絶対失敗するので初めてのロボット掃除機にもおすめですね。次はこちら。またまたドリーミーのコードレススティック掃除機ですね。ドリーミー", "relevance": 0.0, "segment_location": "1:55", "section_title": null}, "index": 2}

