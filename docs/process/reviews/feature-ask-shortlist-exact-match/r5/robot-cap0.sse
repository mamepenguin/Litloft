data: {"citation": {"file_id": "DuRk8Z-B68TR", "drive": "動画", "filename": "【買うなら今！】Amazonプライムデーで今買うべきおすすめアイテム『14選』.loft", "file_type": "video", "quote": "皆さん、こんにちは。まめです。Amazonプライムで今回はおすすめ製品14戦をご紹介[音楽]します。僕が実際に愛用しているものから今回のセール で購入予定のものも惜しみなくお届けするので是非最後までご覧ください。それでは早速行きましょう。まずはこちらポイントアップキャンペーン に必ずエントリーしておきましょう。どこにあるか分からない方は僕の概要欄かこのQRコードからアクセスして必ずエントリーしてか…", "relevance": 0.0, "segment_location": "0:37", "section_title": null}, "index": 1}

event: citation
data: {"citation": {"file_id": "DuRk8Z-B68TR", "drive": "動画", "filename": "【買うなら今！】Amazonプライムデーで今買うべきおすすめアイテム『14選』.loft", "file_type": "video", "quote": "買うと絶対失敗するので初めてのロボット掃除機にもおすめですね。次はこちら。またまたドリーミーのコードレススティック掃除機ですね。ドリーミー", "relevance": 0.0, "segment_location": "1:55", "section_title": null}, "index": 2}

event: citation
data: {"citation": {"file_id": "DuRk8Z-B68TR", "drive": "動画", "filename": "【買うなら今！】Amazonプライムデーで今買うべきおすすめアイテム『14選』.loft", "file_type": "video", "quote": "小スペースで自動収集がついた掃除機が欲しい方におすめですね。次はこちら。AAのスマートロックJ200。AppleHホームの後付けのスマート", "relevance": 0.0, "segment_location": "3:03", "section_title": null}, "index": 3}

