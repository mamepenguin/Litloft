event: citation
data: {"citation": {"file_id": "XomHWUIREQP6", "drive": "動画", "filename": "日本では当たり前の光景に絶叫！中国の友達が日本に来て驚くこと！.loft", "file_type": "video", "quote": "2人で乗っとる時にちょうどその話になって、この前友達がまたこの土手で大絶叫しとったわっていうので、ちょっと動画にしてみようかみたいな。あ、そういうさ、お互いの国のさ、その光景、ま、結構文化の違いとか国の個、", "relevance": 0.0, "segment_location": "12:22", "section_title": null}, "index": 1}

event: citation
data: {"citation": {"file_id": "vtUdYObsQfwD", "drive": "動画", "filename": "これがリアル。Apple発表会の『ウラ側』って結構すごいんです。.loft", "file_type": "video", "quote": "もその動画を作るということで普段使わない筋肉を使ったようなそんな気がしますが、ただね、でもやり終えるとね、すごく気持ちがいいし、やっぱり楽しいな、好き", "relevance": 0.0, "segment_location": "15:59", "section_title": null}, "index": 2}

event: citation
data: {"citation": {"file_id": "aWhA8ZQjZ8Fm", "drive": "動画", "filename": "【YouTube見れる・ChatGPT使える】伝説の「Android電卓」はなぜ生まれ、なぜ消えたのか？謎に包まれた”悲劇の歴史”を解明した。【GHLBD検証-Part4】.loft", "file_type": "video", "quote": "今回もし適当に20分くらいの動画で済ませようと思ってたらここまで深いところにたどり着くことはまずあり得なかったですからねただのおもしろ製品として紹介して終わりになってたかなそう考えると「変態ガジェット」の世界って", "relevance": 0.0, "segment_location": "44:58", "section_title": null}, "index": 3}

event: citations
data: {"citations": [{"file_id": "XomHWUIREQP6", "drive": "動画", "filename": "日本では当たり前の光景に絶叫！中国の友達が日本に来て驚くこと！.loft", "file_type": "video", "quote": "2人で乗っとる時にちょうどその話になって、この前友達がまたこの土手で大絶叫しとったわっていうので、ちょっと動画にしてみようかみたいな。あ、そういうさ、お互いの国のさ、その光景、ま、結構文化の違いとか国の個、", "relevance": 0.0, "segment_location": "12:22", "section_title": null}, {"file_id": "vtUdYObsQfwD", "drive": "動画", "filename": "これがリアル。Apple発表会の『ウラ側』って結構すごいんです。.loft", "file_type": "video", "quote": "もその動画を作るということで普段使わない筋肉を使ったようなそんな気がしますが、ただね、でもやり終えるとね、すごく気持ちがいいし、やっぱり楽しいな、好き", "relevance": 0.0, "segment_location": "15:59", "section_title": null}, {"file_id": "aWhA8ZQjZ8Fm", "drive": "動画", "filename": "【YouTube見れる・ChatGPT使える】伝説の「Android電卓」はなぜ生まれ、なぜ消えたのか？謎に包まれた”悲劇の歴史”を解明した。【GHLBD検証-Part4】.loft", "file_type": "video", "quote": "今回もし適当に20分くらいの動画で済ませようと思ってたらここまで深いところにたどり着くことはまずあり得なかったですからねただのおもしろ製品として紹介して終わりになってたかなそう考えると「変態ガジェット」の世界って", "relevance": 0.0, "segment_location": "44:58", "section_title": null}]}

